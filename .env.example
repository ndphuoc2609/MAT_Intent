# Placeholder only — không điền secret thật vào đây.
# Export biến này vào môi trường trước khi chạy Python; Docker Compose đọc .env.
OPENROUTER_API_KEY=

# Facebook Page used by the separate `meta-services` container.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# `true` enables automatic comment replies and authenticated manual writes.
# Keep false until the Page, permissions, facts, and reply behavior are verified.
META_OUTBOUND_ENABLED=false
META_SERVICE_API_KEY=
