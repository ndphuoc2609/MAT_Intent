# Placeholder only — không điền secret thật vào đây.
# Export biến này vào môi trường trước khi chạy Python; Docker Compose đọc .env.
OPENROUTER_API_KEY=
# Read-only access to content_ai_fac.public.personas for the sandbox.
DB_Host=
DB_Port=5432
DB_Username=
DB_Password=

# Standalone intent API (profile: intent). Migration is explicit; startup never migrates.
INTENT_API_KEY=
INTENT_POSTGRES_USER=mat_intent
INTENT_POSTGRES_PASSWORD=local-only
INTENT_POSTGRES_DB=mat_intent
INTENT_POSTGRES_PORT=55432
INTENT_API_PORT=8780
# For commands run on the host; Compose uses INTENT_SERVICE_DATABASE_URL below.
MAT_INTENT_DATABASE_URL=postgresql://mat_intent:local-only@127.0.0.1:55432/mat_intent
INTENT_SERVICE_DATABASE_URL=postgresql://mat_intent:local-only@intent-postgres:5432/mat_intent
INTENT_LUNA_MODEL=openai/gpt-6-luna-20260922
SANDBOX_ENFORCE_BUDGET=false
SANDBOX_PERSONA_DB=runs/persona_sandbox.sqlite3
INTENT_MODEL_TIMEOUT_SECONDS=45
INTENT_MODEL_MAX_TOKENS=1200
# Set these from the approved budget for this environment/session; no default cap is applied.
INTENT_MODEL_MAX_CALLS=
INTENT_MODEL_MAX_COST_USD=
INTENT_MODEL_RESERVE_USD=
INTENT_BUDGET_LEDGER_PATH=runs/budget_ledger.jsonl
INTENT_JEV_SHADOW_ENABLED=false
INTENT_JEV_MODEL_MAX_CALLS=
INTENT_JEV_MODEL_MAX_COST_USD=
INTENT_JEV_MODEL_RESERVE_USD=
INTENT_JEV_BUDGET_LEDGER_PATH=runs/budget_ledger.jsonl
INTENT_TRACE_PATH=runs/intent_trace.jsonl

# Facebook Page used by the separate `meta-services` container.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# `true` enables automatic comment replies and authenticated manual writes.
# Keep false until the Page, permissions, facts, and reply behavior are verified.
META_OUTBOUND_ENABLED=false
META_SERVICE_API_KEY=
